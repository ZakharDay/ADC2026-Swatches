<%= form_with(model: swatch) do |form| %>
  <% if swatch.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(swatch.errors.count, "error") %> prohibited this swatch from being saved:</h2>

      <ul>
        <% swatch.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :project_id, style: "display: block" %>
    <%= form.select :project_id, current_user.projects.collect { |p| [ p.name, p.id ] }, include_blank: 'Выберите проект' %>
  </div>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
