<p style="color: green"><%= notice %></p>

<% content_for :title, "Fills" %>

<h1>Fills</h1>
<%= link_to "New fill", new_admin_fill_path %>

<br><br>
<hr>
<br>

<div id="fills">
  <% @fills.each do |fill| %>
    <%= render fill %>
    <p>
      <%= link_to "Show this fill", [:admin, fill] %>
    </p>
  <% end %>
</div>
