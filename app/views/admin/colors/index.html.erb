<p style="color: green"><%= notice %></p>

<% content_for :title, "Colors" %>

<h1>Colors</h1>
<%= link_to "New color", new_admin_color_path %>

<br><br>
<hr>
<br>

<div id="colors">
  <% @colors.each do |color| %>
    <%= render color %>
    <p>
      <%= link_to "Show this color", [:admin, color] %>
    </p>
  <% end %>
</div>
