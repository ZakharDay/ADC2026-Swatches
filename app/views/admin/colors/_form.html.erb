<%= form_with(model: [:admin, color]) do |form| %>
  <% if color.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(color.errors.count, "error") %> prohibited this color from being saved:</h2>

      <ul>
        <% color.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :rgb_hash, style: "display: block" %>
    <%= form.color_field :rgb_hash %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
